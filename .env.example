# Llave pública de Culqi (frontend) - obtenla en tu panel de Culqi
VITE_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Llave secreta de Culqi (SOLO backend, nunca la expongas en el frontend)
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Facturador electrónico propio (boletas y facturas en SUNAT). Mientras estén
# vacías, la tienda NO emite comprobantes y funciona igual que siempre.
# La llave se crea en el facturador con: npm run llave-api -- crear --ruc ... --canal "Tienda web"
FACTURADOR_URL=
FACTURADOR_LLAVE=

# Avisos de errores al teléfono (opcional). Sin esto los errores igual se ven
# en el panel, pestaña Mi tienda → Errores. Con ntfy.sh (gratis, sin cuenta):
# instala la app ntfy, suscríbete a un tema difícil de adivinar y pon aquí
# https://ntfy.sh/ESE-TEMA. Ver api/_alertas.js.
ALERTAS_URL=
